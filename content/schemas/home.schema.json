{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "首页配置",
  "description": "首页轮播自动读取 public/assets/home-slides/。此文件仅维护可选图注、介绍配图和展示数量。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gallery",
    "newsLimit",
    "publicationLimit"
  ],
  "properties": {
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "altKey",
          "captionKey"
        ],
        "properties": {
          "url": {
            "$ref": "common.schema.json#/definitions/asset"
          },
          "altKey": {
            "allOf": [
              {
                "$ref": "common.schema.json#/definitions/nonEmptyText"
              }
            ],
            "description": "替代文字在 content/ui.json 中的键名；该键必须同时有 en 和 zh。"
          },
          "captionKey": {
            "allOf": [
              {
                "$ref": "common.schema.json#/definitions/nonEmptyText"
              }
            ],
            "description": "图片说明在 content/ui.json 中的键名；该键必须同时有 en 和 zh。"
          },
          "eyebrowKey": {
            "$ref": "common.schema.json#/definitions/nonEmptyText",
            "description": "图片类别在 content/ui.json 中的键名（可选）；该键必须同时有 en 和 zh。"
          },
          "descriptionKey": {
            "$ref": "common.schema.json#/definitions/nonEmptyText",
            "description": "图片简介在 content/ui.json 中的键名（可选）；该键必须同时有 en 和 zh。"
          }
        }
      },
      "description": "首页介绍区的图片与图文简介，按数组顺序显示。"
    },
    "newsLimit": {
      "type": "integer",
      "minimum": 1,
      "description": "首页展示的最新新闻条数。"
    },
    "publicationLimit": {
      "type": "integer",
      "minimum": 1,
      "description": "首页展示的论文条数。"
    },
    "heroLabels": {
      "type": "object",
      "description": "可选轮播图注，以 public/assets/home-slides/ 中的完整文件名为键；新增图片无需填写。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "altKey": {
            "allOf": [
              {
                "$ref": "common.schema.json#/definitions/nonEmptyText"
              }
            ],
            "description": "替代文字在 content/ui.json 中的键名；该键必须同时有 en 和 zh。"
          },
          "captionKey": {
            "allOf": [
              {
                "$ref": "common.schema.json#/definitions/nonEmptyText"
              }
            ],
            "description": "图片说明在 content/ui.json 中的键名；该键必须同时有 en 和 zh。"
          }
        }
      }
    }
  }
}
